<main class="start-screen">
    <div class="start-screen__content">
        <div class="start-screen__masthead">
            <span class="start-screen__eyebrow">ソーシャルクラブへようこそ</span>
            <h1 class="start-screen__title"><span>SOC</span><span class="start-screen__title-accent">OPS</span></h1>
            <p class="start-screen__subtitle">会話がはずむ、ソーシャルビンゴ</p>
        </div>

        <section class="start-screen__guide" aria-labelledby="guide-title">
            <div class="start-screen__guide-heading">
                <span class="start-screen__guide-kicker">さあ、はじめよう</span>
                <h2 id="guide-title">遊び方はかんたん</h2>
            </div>
            <ol class="start-screen__steps">
                <li><span class="start-screen__step-number">01</span><span>マスの質問に合う人を見つけよう</span></li>
                <li><span class="start-screen__step-number">02</span><span>見つけたらマスをタップ</span></li>
                <li><span class="start-screen__step-number">03</span><span>タテ・ヨコ・ナナメに5つ並べてビンゴ！</span></li>
            </ol>
        </section>

        <button @onclick="OnStart" class="start-screen__button">
            <span>パーティーに参加する</span>
            <span class="start-screen__button-arrow" aria-hidden="true">→</span>
        </button>
        <p class="start-screen__footer">知らない誰かと、最高の一列を。</p>
    </div>
</main>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
