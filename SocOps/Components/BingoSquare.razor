@using SocOps.Models

<button
    @onclick="OnClick"
    disabled="@Square.IsFreeSpace"
    class="@GetCssClasses()"
    aria-pressed="@Square.IsMarked"
    aria-label="@GetAriaLabel()">
    <span class="bingo-square__label">@(Square.IsFreeSpace ? "フリースペース" : Square.Text)</span>
    @if (Square.IsMarked)
    {
        <span class="bingo-square__check" aria-hidden="true">✓</span>
    }
</button>

@code {
    [Parameter]
    public BingoSquareData Square { get; set; } = null!;

    [Parameter]
    public bool IsWinning { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string GetCssClasses()
    {
        if (Square.IsFreeSpace)
        {
            return "bingo-square bingo-square--free";
        }

        if (IsWinning)
        {
            return "bingo-square bingo-square--winning";
        }

        return Square.IsMarked ? "bingo-square bingo-square--marked" : "bingo-square";
    }

    private string GetAriaLabel()
    {
        var label = Square.IsFreeSpace ? "フリースペース" : Square.Text;

        if (Square.IsMarked)
        {
            label += "、選択済み";
        }

        if (IsWinning)
        {
            label += "、ビンゴライン";
        }

        return label;
    }
}
