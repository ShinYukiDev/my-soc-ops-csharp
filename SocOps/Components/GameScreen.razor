@using SocOps.Models

<div class="game-screen">
    <header class="game-screen__header">
        <button @onclick="OnReset" class="game-screen__back">
            <span aria-hidden="true">←</span>
            <span>最初に戻る</span>
        </button>
        <h1 class="game-screen__brand"><span>SOC</span><span>OPS</span></h1>
        <span class="game-screen__edition">SOCIAL BINGO</span>
    </header>

    <main class="game-screen__main">
        <div class="game-screen__intro">
            <p class="game-screen__eyebrow">人と出会って、マスをつなごう</p>
            <p class="game-screen__instructions">質問にぴったりの人を見つけたら、マスをタップ！</p>
        </div>

    @if (HasBingo)
    {
        <div class="game-screen__bingo-banner" role="status" aria-live="polite">
            <span class="game-screen__bingo-mark" aria-hidden="true">✦</span>
            <span>ビンゴ達成！おめでとう！</span>
            <span class="game-screen__bingo-mark" aria-hidden="true">✦</span>
        </div>
    }

        <div class="game-screen__board-wrap">
        <BingoBoard
            Board="@Board"
            WinningSquareIds="@WinningSquareIds"
            OnSquareClick="@OnSquareClick" />
        </div>
        <p class="game-screen__footer">フリースペースも使って、ビンゴを狙おう</p>
    </main>
</div>

@code {
    [Parameter]
    public List<BingoSquareData> Board { get; set; } = new();

    [Parameter]
    public HashSet<int> WinningSquareIds { get; set; } = new();

    [Parameter]
    public bool HasBingo { get; set; }

    [Parameter]
    public EventCallback<int> OnSquareClick { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }
}
