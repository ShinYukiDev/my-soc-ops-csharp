<div class="bingo-modal-backdrop">
    <section class="bingo-modal" role="dialog" aria-modal="true" aria-labelledby="bingo-modal-title">
        <span class="bingo-modal__spark bingo-modal__spark--left" aria-hidden="true">✦</span>
        <span class="bingo-modal__spark bingo-modal__spark--right" aria-hidden="true">✦</span>
        <p class="bingo-modal__eyebrow">最高の盛り上がり！</p>
        <h2 id="bingo-modal-title" class="bingo-modal__title">ビンゴ！</h2>
        <p class="bingo-modal__message">みんなとつながる一列が完成！</p>

        <button
            @onclick="OnDismiss"
            class="bingo-modal__button">
            ゲームを続ける
        </button>
    </section>
</div>

@code {
    [Parameter]
    public EventCallback OnDismiss { get; set; }
}
